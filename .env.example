# Copy to .env and fill in. DO NOT commit your real .env.
# Generate FLASK_SECRET_KEY locally with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Core ---
FLASK_SECRET_KEY=please-generate-a-random-48-char-string
FLASK_DEBUG=false
APP_BASE_URL=http://localhost:5000

# --- Database (Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_alert_db
DB_USER=postgres
DB_PASSWORD=

# Set true ONCE to wipe + recreate schema. Leave false afterwards.
DROP_AND_REBUILD_SCHEMA=false

# --- SMTP for OTP / password-reset / digests ---
# Gmail: use an App Password from https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=
SMTP_FROM_NAME=StockSense Alerts

# --- Stock data (optional) ---
ALPHA_VANTAGE_KEY=

# --- Cache + rate-limit (optional, falls back to in-memory) ---
# REDIS_URL=redis://localhost:6379/1
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# --- Error tracking (optional) ---
# SENTRY_DSN=
